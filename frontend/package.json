{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n 'CODEGEN,NEXT' -c 'blue,green' 'npm run codegen:watch' 'npm run dev:nextjs'",
    "dev:nextjs": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "playwright test",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --watch --config codegen.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "dotenv": "17.3.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "^8.6.0",
    "envalid": "^8.1.1",
    "graphql-request": "^7.4.0",
    "html-react-parser": "^5.2.17",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-smart-masonry": "^2.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-graphql-request": "^7.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@parcel/watcher": "^2.5.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "graphql": "^16.13.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "dotenv": "17.3.1"
  }
}
